<?xml version="1.0" encoding="utf-8"?>
<!--
  El circulo de estado de la tarjeta de toma. El relleno, el color y el grosor del
  borde los pone TomaAdapter segun el estado y el modo de vision: nunca se distingue
  un estado solo por color.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/tp_transparente" />
    <stroke android:width="2dp" android:color="@color/tp_borde" />
</shape>
