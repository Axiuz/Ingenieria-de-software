<?xml version="1.0" encoding="utf-8"?>
<!-- Lista de personas a cargo del cuidador. Reemplaza a "Mis medicinas" en ese rol. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/tp_pad_pantalla">

    <TextView
        style="@style/T.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/personas_titulo" />

    <TextView
        android:id="@+id/cuenta"
        style="@style/T.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <include
        layout="@layout/view_estado_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/tpSep" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="?attr/tpSep"
        android:clipToPadding="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/agregar"
        style="@style/Widget.TuPastilla.Boton.Primario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/personas_agregar" />
</LinearLayout>
