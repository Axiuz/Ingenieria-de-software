<?xml version="1.0" encoding="utf-8"?>
<!-- B8 + B9 · Cabecera de cumplimiento y tomas agrupadas por dia. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tp_pad_pantalla">

        <TextView
            style="@style/T.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/b8_titulo" />

        <TextView
            style="@style/T.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/b8_ultimos" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaCumplimiento"
            style="@style/Widget.TuPastilla.Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cumplimientoMes"
                    style="@style/T.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="0dp" />

                <TextView
                    android:id="@+id/porcentaje"
                    style="@style/T.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    style="@style/T.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/b9_pct_desc" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:trackCornerRadius="5dp"
                    app:trackThickness="10dp" />

                <LinearLayout
                    android:id="@+id/resumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <include
            layout="@layout/view_estado_vacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
