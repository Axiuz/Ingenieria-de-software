<?xml version="1.0" encoding="utf-8"?>
<!-- B7 · Cuando debe tomarse: horas, dias de la semana y vigencia. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tp_pad_pantalla">

        <include layout="@layout/view_barra_volver" />

        <TextView
            android:id="@+id/titulo"
            style="@style/T.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/T.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/b7_cuando" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Horas sugeridas: cuatro toques en vez de abrir el reloj cada vez. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sugeridas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/otraHora"
            style="@style/Widget.TuPastilla.Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/b7_otra_hora" />

        <TextView
            style="@style/T.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/b7_dias" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/dias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:orientation="vertical"
            android:background="@drawable/bg_superficie"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/filaDesde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/tpTouchMin"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/T.Cuerpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/b7_desde" />

                <TextView
                    android:id="@+id/valorDesde"
                    style="@style/T.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filaHasta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/tpTouchMin"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/T.Cuerpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/b7_hasta" />

                <TextView
                    android:id="@+id/valorHasta"
                    style="@style/T.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="?attr/tpSep" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/listo"
            style="@style/Widget.TuPastilla.Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/b7_listo" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
