<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Texto ===== -->
    <!-- Todo sale de ?attr/tpText*, asi el cambio de densidad no toca ningun layout. -->
    <style name="T">
        <item name="android:textColor">@color/tp_texto_primario</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="T.Display">
        <item name="android:textSize">?attr/tpTextDisplay</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="T.Titulo">
        <item name="android:textSize">?attr/tpTextTitulo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="T.Cuerpo">
        <item name="android:textSize">?attr/tpTextCuerpo</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="T.Tarjeta">
        <item name="android:textSize">?attr/tpTextTarjeta</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="T.Meta">
        <item name="android:textSize">?attr/tpTextMeta</item>
        <item name="android:textColor">@color/tp_texto_secundario</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="T.Etiqueta">
        <item name="android:textSize">?attr/tpTextEtiqueta</item>
        <item name="android:textColor">@color/tp_texto_terciario</item>
    </style>

    <style name="T.Overline">
        <item name="android:layout_marginTop">?attr/tpSep</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textSize">?attr/tpTextEtiqueta</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textColor">@color/tp_texto_terciario</item>
    </style>

    <!-- ===== Boton grande ===== -->
    <!-- insetTop/Bottom a 0: si no, Material recorta el area tactil de 64 dp. -->
    <style name="Widget.TuPastilla.Boton.Primario" parent="Widget.Material3.Button">
        <item name="android:minHeight">?attr/tpTouchMin</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">?attr/tpTextCuerpo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/tpAccion</item>
        <item name="android:textColor">@color/tp_sobre_accion</item>
        <item name="cornerRadius">@dimen/tp_radio_boton</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.TuPastilla.Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">?attr/tpTouchMin</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">?attr/tpTextCuerpo</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/tp_borde</item>
        <item name="strokeWidth">@dimen/tp_borde_estado</item>
        <item name="android:textColor">@color/tp_texto_primario</item>
        <item name="cornerRadius">@dimen/tp_radio_boton</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Texto plano, para "Saltar por ahora" y similares. -->
    <style name="Widget.TuPastilla.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">?attr/tpTouchMin</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">?attr/tpTextCuerpo</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tp_texto_secundario</item>
    </style>

    <!-- ===== Campo de formulario ===== -->
    <style name="Widget.TuPastilla.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/tp_borde</item>
        <item name="boxStrokeWidth">@dimen/tp_borde_estado</item>
        <item name="boxStrokeWidthFocused">@dimen/tp_borde_destacado</item>
        <item name="boxCornerRadiusTopStart">@dimen/tp_radio_tarjeta</item>
        <item name="boxCornerRadiusTopEnd">@dimen/tp_radio_tarjeta</item>
        <item name="boxCornerRadiusBottomStart">@dimen/tp_radio_tarjeta</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/tp_radio_tarjeta</item>
        <item name="boxBackgroundColor">@color/tp_superficie</item>
        <item name="android:minHeight">?attr/tpTouchMin</item>
        <item name="hintTextColor">@color/tp_texto_secundario</item>
        <item name="errorTextColor">?attr/tpOmitida</item>
        <item name="boxStrokeErrorColor">?attr/tpOmitida</item>
    </style>

    <style name="Widget.TuPastilla.Campo.Texto" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">?attr/tpTextCuerpo</item>
        <item name="android:textColor">@color/tp_texto_primario</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <!-- ===== Chips ===== -->
    <!--
      El dia elegido lleva ademas la palomita de Material (checkedIcon): igual que en
      las tarjetas de toma, la seleccion no puede depender solo del color.
    -->
    <style name="Widget.TuPastilla.Chip.Dia" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">?attr/tpTouchMin</item>
        <item name="android:textSize">?attr/tpTextMeta</item>
        <item name="android:textColor">@color/tp_chip_texto</item>
        <item name="chipBackgroundColor">@color/tp_superficie</item>
        <item name="chipStrokeColor">@color/tp_chip_borde</item>
        <item name="chipStrokeWidth">@dimen/tp_borde_estado</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIconTint">?attr/tpAccion</item>
        <item name="chipCornerRadius">@dimen/tp_radio_boton</item>
    </style>

    <style name="Widget.TuPastilla.Chip.Hora" parent="Widget.Material3.Chip.Assist">
        <item name="android:minHeight">?attr/tpTouchMin</item>
        <item name="android:textSize">?attr/tpTextMeta</item>
        <item name="android:textColor">@color/tp_texto_primario</item>
        <item name="chipBackgroundColor">@color/tp_superficie</item>
        <item name="chipStrokeColor">@color/tp_borde</item>
        <item name="chipStrokeWidth">@dimen/tp_borde_estado</item>
        <item name="chipCornerRadius">@dimen/tp_radio_boton</item>
    </style>

    <!-- ===== Tarjeta de medicamento ===== -->
    <!-- Un solo estilo para los 12 casos: el estado pone strokeColor y strokeWidth. -->
    <style name="Widget.TuPastilla.TarjetaMedicamento" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/tp_transparente</item>
        <item name="cardCornerRadius">@dimen/tp_radio_tarjeta</item>
        <item name="strokeWidth">@dimen/tp_borde_estado</item>
        <item name="strokeColor">@color/tp_borde</item>
        <item name="contentPadding">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Tarjeta neutra de superficie: paneles de ajustes, permisos, detalle. -->
    <style name="Widget.TuPastilla.Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/tp_superficie</item>
        <item name="cardCornerRadius">@dimen/tp_radio_tarjeta</item>
        <item name="strokeWidth">@dimen/tp_borde_estado</item>
        <item name="strokeColor">@color/tp_borde</item>
        <item name="contentPadding">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Tarjeta que se puede tocar: rol, modo de vision, densidad, medicina. -->
    <style name="Widget.TuPastilla.Tarjeta.Seleccionable">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">?attr/tpTouchMin</item>
        <item name="rippleColor">@color/tp_borde</item>
    </style>
</resources>
