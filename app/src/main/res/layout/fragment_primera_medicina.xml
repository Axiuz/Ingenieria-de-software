<?xml version="1.0" encoding="utf-8"?>
<!-- C15 · Ultimo paso, salteable. Al aceptar se reutiliza B6 con primeraVez=true. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/tp_pad_pantalla">

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_pastilla"
        android:importantForAccessibility="no" />

    <TextView
        style="@style/T.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/tpSep"
        android:text="@string/c15_titulo" />

    <TextView
        style="@style/T.Cuerpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/tp_texto_secundario"
        android:text="@string/c15_subtitulo" />

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/agregar"
        style="@style/Widget.TuPastilla.Boton.Primario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/a4b_agregar_corto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saltar"
        style="@style/Widget.TuPastilla.Boton.Texto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/c15_saltar" />
</LinearLayout>
