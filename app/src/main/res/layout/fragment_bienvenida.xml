<?xml version="1.0" encoding="utf-8"?>
<!-- C0 · Paso 1 de 5. El rol ya viene de la cuenta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/tp_pad_pantalla">

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_pastilla"
        android:importantForAccessibility="no" />

    <TextView
        style="@style/T.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/tpSep"
        android:text="@string/c0_titulo" />

    <TextView
        style="@style/T.Cuerpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/tp_texto_secundario"
        android:text="@string/c0_subtitulo" />

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empezar"
        style="@style/Widget.TuPastilla.Boton.Primario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/c0_empezar" />
</LinearLayout>
