<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja inferior generica: motivos de omision (A1) y tamano de caja al resurtir (B10). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hoja"
    android:padding="@dimen/tp_pad_pantalla">

    <TextView
        android:id="@+id/hojaTitulo"
        style="@style/T.Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/hojaSubtitulo"
        style="@style/T.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/hojaOpciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/tpSep"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/hojaCancelar"
        style="@style/Widget.TuPastilla.Boton.Texto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cancelar" />
</LinearLayout>
