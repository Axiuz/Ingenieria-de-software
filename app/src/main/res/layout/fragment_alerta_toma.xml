<?xml version="1.0" encoding="utf-8"?>
<!--
  A2 · Sin scroll y con dos acciones, nada mas. Es lo que ve alguien recien despertado
  con el telefono bloqueado: cualquier cosa de mas sobra.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/tp_pad_pantalla">

    <TextView
        android:id="@+id/etiquetaHora"
        style="@style/T.Overline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/icono"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="?attr/tpSep"
        android:src="@drawable/ic_pastilla"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/etiquetaHora"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/nombre"
        style="@style/T.Display"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/tpSep"
        app:layout_constraintTop_toBottomOf="@id/icono"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/dosis"
        style="@style/T.Cuerpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/tp_texto_secundario"
        app:layout_constraintTop_toBottomOf="@id/nombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- El foco inicial es confirmar: es la accion que se espera a esta hora. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirmar"
        style="@style/Widget.TuPastilla.Boton.Primario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/a1_ya_la_tome"
        app:layout_constraintBottom_toTopOf="@id/posponer"
        android:layout_marginBottom="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/posponer"
        style="@style/Widget.TuPastilla.Boton.Secundario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/a2_ahora_no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
