<?xml version="1.0" encoding="utf-8"?>
<!-- C11 · Eleccion por comparacion, nunca por diagnostico. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tp_pad_pantalla">

        <TextView
            style="@style/T.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:text="@string/c11_titulo" />

        <TextView
            style="@style/T.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/c11_subtitulo" />

        <LinearLayout
            android:id="@+id/muestras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inseguro"
            style="@style/Widget.TuPastilla.Boton.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:text="@string/c11_inseguro" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
