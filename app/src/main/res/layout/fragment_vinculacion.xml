<?xml version="1.0" encoding="utf-8"?>
<!-- C12a · El codigo que el paciente le dicta a su familiar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/tp_pad_pantalla">

    <include layout="@layout/view_barra_volver" />

    <TextView
        style="@style/T.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/c12a_titulo" />

    <TextView
        style="@style/T.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/c12a_subtitulo" />

    <TextView
        android:id="@+id/codigo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/tpSep"
        android:background="@drawable/bg_superficie"
        android:gravity="center"
        android:paddingTop="26dp"
        android:paddingBottom="26dp"
        android:textSize="44sp"
        android:textStyle="bold"
        android:letterSpacing="0.22"
        android:textColor="@color/tp_texto_primario"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/vence"
        style="@style/T.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center" />

    <TextView
        style="@style/T.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/tpSep"
        android:text="@string/c12a_pie" />

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/regenerar"
        style="@style/Widget.TuPastilla.Boton.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/c12a_otro" />
</LinearLayout>
