<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tp_pad_pantalla">

        <include layout="@layout/view_barra_volver" />

        <TextView
            style="@style/T.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/registro_titulo" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoNombre"
            style="@style/Widget.TuPastilla.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:hint="@string/campo_nombre">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/entradaNombre"
                style="@style/Widget.TuPastilla.Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:autofillHints="name" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoCorreo"
            style="@style/Widget.TuPastilla.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/campo_correo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/entradaCorreo"
                style="@style/Widget.TuPastilla.Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoPassword"
            style="@style/Widget.TuPastilla.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/campo_password"
            app:endIconMode="password_toggle"
            app:helperText="@string/registro_password_ayuda">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/entradaPassword"
                style="@style/Widget.TuPastilla.Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:autofillHints="newPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/T.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:text="@string/registro_rol_titulo" />

        <LinearLayout
            android:id="@+id/opcionesRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/error"
            style="@style/T.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="?attr/tpOmitida"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/cargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crearCuenta"
            style="@style/Widget.TuPastilla.Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:layout_marginBottom="16dp"
            android:text="@string/registro_crear" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
