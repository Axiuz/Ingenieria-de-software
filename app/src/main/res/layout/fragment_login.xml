<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tp_pad_pantalla">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="?attr/tpSep"
            android:src="@drawable/ic_pastilla"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/T.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:text="@string/login_titulo" />

        <TextView
            style="@style/T.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/tp_texto_secundario"
            android:text="@string/login_subtitulo" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoCorreo"
            style="@style/Widget.TuPastilla.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/tpSep"
            android:hint="@string/campo_correo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/entradaCorreo"
                style="@style/Widget.TuPastilla.Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoPassword"
            style="@style/Widget.TuPastilla.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/campo_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/entradaPassword"
                style="@style/Widget.TuPastilla.Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/error"
            style="@style/T.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="?attr/tpOmitida"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/cargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/entrar"
            style="@style/Widget.TuPastilla.Boton.Primario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/login_entrar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/irARegistro"
            style="@style/Widget.TuPastilla.Boton.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/login_crear_cuenta" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
